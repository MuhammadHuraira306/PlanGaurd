# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port (must be 3000 in AI Studio preview)
PORT=3000

# Model Provider Configuration ('gemini' or 'local')
PLANGUARD_PROVIDER="gemini"
PLANGUARD_MODEL="gemini-3.1-flash-lite"

# Optional Local / OpenAI-compatible Endpoint (e.g., Ollama http://localhost:11434/v1)
LOCAL_LLM_BASE_URL=""
LOCAL_LLM_MODEL=""
